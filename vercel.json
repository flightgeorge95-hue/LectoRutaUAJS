{
  "headers": [
    {
      "source": "/images/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Encoding",
          "value": "br, gzip"
        }
      ]
    },
    {
      "source": "/audio/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "overrides": [
    {
      "path": "**/*.html",
      "compression": "br"
    },
    {
      "path": "**/*.js",
      "compression": "br"
    },
    {
      "path": "**/*.css",
      "compression": "br"
    },
    {
      "path": "**/*.json",
      "compression": "br"
    },
    {
      "path": "**/*.svg",
      "compression": "br"
    }
  ]
}
