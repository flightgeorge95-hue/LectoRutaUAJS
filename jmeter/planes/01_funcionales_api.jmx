  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="LectoRuta Saber · 01 Pruebas funcionales de la API"><stringProp name="TestPlan.comments">48 casos de prueba funcionales, de seguridad y de validación. Un usuario virtual, una iteración, grupos en serie.
No destructivo: solo lectura (los logins registran intentos de acceso).
Ejecutar con: -q config/credenciales.properties</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables definidas por el usuario"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,lecto-ruta.vercel.app)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PROTOCOL" elementType="Argument"><stringProp name="Argument.name">PROTOCOL</stringProp><stringProp name="Argument.value">${__P(protocol,https)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PORT" elementType="Argument"><stringProp name="Argument.name">PORT</stringProp><stringProp name="Argument.value">${__P(port,443)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="EST_TARJETA" elementType="Argument"><stringProp name="Argument.name">EST_TARJETA</stringProp><stringProp name="Argument.value">${__P(est_tarjeta,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="EST_PASSWORD" elementType="Argument"><stringProp name="Argument.name">EST_PASSWORD</stringProp><stringProp name="Argument.value">${__P(est_password,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DOC_CEDULA" elementType="Argument"><stringProp name="Argument.name">DOC_CEDULA</stringProp><stringProp name="Argument.value">${__P(doc_cedula,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DOC_PASSWORD" elementType="Argument"><stringProp name="Argument.name">DOC_PASSWORD