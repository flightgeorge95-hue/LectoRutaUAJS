# Copia este archivo como .env.local y completa los valores.
# En Vercel: Settings → Environment Variables.

# Cadena de conexión de MongoDB (Atlas o local)
MONGODB_URI=mongodb://localhost:27017/lectosaber

# Secreto para firmar las sesiones JWT (OBLIGATORIO en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
